# optional: pin the recorder; leave unset to pick one via the API and let the server remember it
##BDZBRIDGE_RECORDER_MAC=f8:4e:17:00:00:00   # Wake-on-LAN; normally learned automatically
BDZBRIDGE_RECORDER_HOST=192.0.2.10
# optional: CIDRs to scan when SSDP finds nothing (default: primary interface /24)
#BDZBRIDGE_SCAN_NETWORKS=192.0.2.0/24
BDZBRIDGE_API_TOKEN=change-me
BDZBRIDGE_DB_PATH=data/bdzbridge.sqlite3
BDZBRIDGE_EPG_REFRESH_HOURS=3
BDZBRIDGE_DEFAULT_QUALITY=LSR
BDZBRIDGE_DEFAULT_REPEAT=none
BDZBRIDGE_BIND_HOST=127.0.0.1
BDZBRIDGE_BIND_PORT=8000

# Notifications for keyword auto-reservation (optional). E-mail needs SMTP; a webhook gets a JSON POST.
#BDZBRIDGE_SMTP_HOST=smtp.example.com
#BDZBRIDGE_SMTP_PORT=587
#BDZBRIDGE_SMTP_USER=you@example.com
#BDZBRIDGE_SMTP_PASSWORD=app-password
#BDZBRIDGE_NOTIFY_TO=you@example.com
#BDZBRIDGE_NOTIFY_WEBHOOK=https://ntfy.sh/your-topic
