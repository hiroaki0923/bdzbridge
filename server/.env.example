# optional: pin the recorder; leave unset to pick one via the API and let the server remember it
#RECBRIDGE_RECORDER_HOST=192.0.2.10
# optional: CIDRs to scan when SSDP finds nothing (default: primary interface /24)
#RECBRIDGE_SCAN_NETWORKS=192.0.2.0/24
RECBRIDGE_API_TOKEN=change-me
RECBRIDGE_DB_PATH=data/recbridge.sqlite3
RECBRIDGE_EPG_REFRESH_HOURS=3
RECBRIDGE_DEFAULT_QUALITY=LSR
RECBRIDGE_DEFAULT_REPEAT=none
RECBRIDGE_BIND_HOST=127.0.0.1
RECBRIDGE_BIND_PORT=8000
