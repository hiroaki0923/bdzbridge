<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- The recorder and the television are asked over the LAN. Plain HTTP needs no setting here: the requests go
         through Swift's URLSession, which the network security policy does not govern (docs/android-port-study.md). -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <application
        android:label="@string/app_name"
        android:allowBackup="false"
        android:theme="@android:style/Theme.Material.Light.NoActionBar">
        <!-- A turn or a resize does not make the activity again: the composition is kept, which a new activity would
             throw away, and Compose lays the screen out again for the size the configuration says, a bar or a rail at
             600 dp (`Destinations`) and a sheet or the pane at 840 dp (`twoPanes`). Across either, what the screens
             hold is kept: where the lists are scrolled, the top app bars with what they have open, and what is open,
             which goes from a sheet into the pane or back with the one window it has to the model. A change of dark
             or light, of language, of the text's size or of the display's still makes it again. -->
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|keyboard|keyboardHidden|navigation">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>
</manifest>
