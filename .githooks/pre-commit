#!/bin/sh
# Keep the generated docs (docs/api.md, docs/openapi.json, docs/port/*) in step with the server. Enable once with:
#   git config core.hooksPath .githooks
set -e

# Refuse signing keys, certificates and store API keys; this repository is public.
staged=$(git diff --cached --name-only --diff-filter=AM |
  grep -Ei '(\.(jks|keystore|p12|cer|mobileprovision)$|(^|/)key\.properties$|AuthKey_.*\.p8$)' || true)
if [ -n "$staged" ]; then
  echo "pre-commit: refusing to commit signing material:" >&2
  echo "$staged" | sed 's/^/  /' >&2
  echo "keep these outside the repository (see docs/porting.md)" >&2
  exit 1
fi
if git diff --cached --name-only | grep -q '^server/bdzbridge/'; then
  (cd server && uv run -q python -m bdzbridge.tools.apidoc >/dev/null && uv run -q python -m bdzbridge.tools.portkit >/dev/null)
  git add docs/api.md docs/openapi.json docs/port
fi

# A privacy manifest that Apple rejects looks fine to `plutil -lint`: it accepts XML that a strict parser
# will not, and an invalid manifest costs a whole review round trip (ITMS-91056 -- ours had "--" inside an
# XML comment, which XML does not allow). Python's parser is the strict one.
for manifest in $(git diff --cached --name-only --diff-filter=AM | grep '\.xcprivacy$' || true); do
  if ! python3 -c "import plistlib,sys;plistlib.loads(open(sys.argv[1],'rb').read())" "$manifest" 2>/dev/null; then
    echo "pre-commit: $manifest is not well-formed; Apple will refuse the build (ITMS-91056)" >&2
    python3 -c "import plistlib,sys;plistlib.loads(open(sys.argv[1],'rb').read())" "$manifest" 2>&1 | tail -2 >&2
    exit 1
  fi
done

# The Xcode project is generated from app/project.yml and committed all the same, because Xcode Cloud has to
# find a project in the repository before any script of ours runs (see app/README.md). So the two have to
# agree. Generating elsewhere and comparing does not work -- XcodeGen writes paths relative to wherever it
# put the project -- so this regenerates in place, compares, and puts the file back when it matches.
# One group's identifier is random on every run, which is why the comparison ignores those lines.
if git diff --cached --name-only | grep -q '^app/' && command -v xcodegen >/dev/null 2>&1; then
  (cd app && xcodegen generate >/dev/null 2>&1) || true
  if ! git diff --ignore-matching-lines=TEMP_ --quiet -- app/BDBridge.xcodeproj app/BDBridge/Info.plist; then
    echo "pre-commit: app/BDBridge.xcodeproj no longer matches app/project.yml" >&2
    echo "  it has just been regenerated in your working tree; check it and 'git add app/BDBridge.xcodeproj app/BDBridge/Info.plist'" >&2
    exit 1
  fi
  git checkout -- app/BDBridge.xcodeproj app/BDBridge/Info.plist
fi

# RecorderKit is checked against docs/port, so run it whenever either side moves. Drop this block if it makes
# commits too slow; `cd app/RecorderKit && swift test` is the same check by hand.
#
# Its output is kept, and what matters in it is shown when it fails. It used to be thrown away for a fixed line
# saying the vectors no longer matched, which sent the reader to run it all again to find out what had failed,
# and was wrong whenever it was anything else. The end alone is not enough either: XCTest reports the suites
# in order and then a summary, so a failing test's own line is somewhere in the middle, and the last lines
# say only how many failed. So the lines that say error -- a test's assertion, or the compiler's -- come first,
# then the end.
if git diff --cached --name-only | grep -qE '^(app/|docs/port/)' && command -v swift >/dev/null 2>&1; then
  if ! output=$(cd app/RecorderKit && swift test 2>&1); then
    echo "pre-commit: RecorderKit's tests fail ('cd app/RecorderKit && swift test' for all of it):" >&2
    echo "$output" | grep 'error:' | head -n 20 >&2
    echo "  ..." >&2
    echo "$output" | tail -n 10 >&2
    exit 1
  fi
fi
